<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/offwhite">

        <TextView
            android:id="@+id/txtDashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shopping Dashboard"
            android:fontFamily="@font/poppins"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/purple"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewCart"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_addtocart"
                android:drawableStart="@drawable/baseline_shopping_cart_24"
                android:drawablePadding="6dp"
                android:drawableTint="@color/white"
                android:elevation="4dp"
                android:fontFamily="@font/poppins_semibold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:stateListAnimator="@null"
                android:text="View Cart"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOrderHistory"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_back_loginhere"
                android:drawableStart="@drawable/baseline_history_24"
                android:drawablePadding="6dp"
                android:drawableTint="@color/purple"
                android:elevation="4dp"
                android:fontFamily="@font/poppins_semibold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:stateListAnimator="@null"
                android:text="Order History"
                android:textAllCaps="false"
                android:textColor="@color/purple"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/productsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>